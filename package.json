{
   "name": "Market_ly",
   "version": "0.1.0",
   "private": true,
   "scripts": {
      "dev": "next dev",
      "build": "npm run prisma:generate && next build",
      "start": "next start",
      "lint": "next lint",
      "seed": "tsx prisma/seed.ts",
      "admin:create": "tsx prisma/create-admin.ts",
      "prisma:generate": "node scripts/prisma-mongo-cli.mjs generate",
      "db:push": "node scripts/prisma-mongo-cli.mjs db push",
      "data:copy:dry-run": "node --import tsx prisma/copy-postgres-data-to-mongodb.ts",
      "data:copy:apply": "node --import tsx prisma/copy-postgres-data-to-mongodb.ts --apply",
      "postinstall": "npm run prisma:generate",
      "vercel-build": "npm run prisma:generate && next build"
   },
   "dependencies": {
      "@auth/prisma-adapter": "^2.11.3",
      "@prisma/client": "6.19.3",
      "mongodb": "^7.7.0",
      "next": "^15.5.26",
      "next-auth": "^5.0.0-beta.25",
      "nodemailer": "^8.0.11",
      "pg": "^8.23.1",
      "prisma": "6.19.3",
      "react": "^19.0.1",
      "react-dom": "^19.0.1",
      "stripe": "^23.0.0"
   },
   "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.23.1"
   },
   "devDependencies": {
      "@types/node": "^20",
      "@types/pg": "^8.23.1",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "dotenv": "^18.0.4",
      "eslint": "^9.39.5",
      "eslint-config-next": "^15.1.0",
      "tsx": "^4.23.15",
      "typescript": "^5"
   },
   "allowScripts": {
      "@prisma/client": true,
      "@prisma/engines": true,
      "prisma": true,
      "esbuild": true,
      "unrs-resolver": true
   }
}
