generator client {
   provider      = "prisma-client-js"
   binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
   provider = "mongodb"
   url      = env("MONGODB_URI")
}

// ================================
// Enums
// ================================

enum UserRole {
   USER
   ADMIN
}

enum CampaignStatus {
   DRAFT
   ACTIVE
   PAUSED
   COMPLETED
   ARCHIVED
}

enum SubmissionStatus {
   PENDING
   APPROVED
   REJECTED
   PAID
}

// ================================
// Auth models (NextAuth)
// ================================

model User {
   id             String    @id @default(cuid()) @map("_id")
   name           String
   email          String    @unique
   emailVerified  DateTime?
   image          String?
   passwordHash   String?
   role           UserRole  @default(USER)
   creditsBalance Int       @default(0)
   createdAt      DateTime  @default(now())

   accounts                Account[]
   sessions                Session[]
   emailVerificationTokens EmailVerificationToken[]
   passwordResetTokens     PasswordResetToken[]
   campaigns               Campaign[]             @relation("CampaignCreator")
   members                 CampaignMember[]
   submissions             Submission[]
   conversationMemberships ConversationMember[]
   sentMessages            Message[]              @relation("SentMessages")
   receivedMessages        Message[]              @relation("ReceivedMessages")
   notifications           Notification[]
   transactions            Transaction[]
   contributions           CampaignContributor[]
   creditTransactions      CreditLedger[]

   @@map("User")
}

model Account {
   id                String  @id @default(cuid()) @map("_id")
   userId            String
   type              String
   provider          String
   providerAccountId String
   refresh_token     String?
   access_token      String?
   expires_at        Int?
   token_type        String?
   scope             String?
   id_token          String?
   session_state     String?

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@unique([provider, providerAccountId])
   @@map("Account")
}

model Session {
   id           String   @id @default(cuid()) @map("_id")
   sessionToken String   @unique
   userId       String
   expires      DateTime

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@map("Session")
}

model EmailVerificationToken {
   id        String   @id @default(cuid()) @map("_id")
   userId    String
   tokenHash String   @unique
   expiresAt DateTime
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([expiresAt])
   @@map("EmailVerificationToken")
}

model PasswordResetToken {
   id        String   @id @default(cuid()) @map("_id")
   userId    String
   tokenHash String   @unique
   expiresAt DateTime
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([expiresAt])
   @@map("PasswordResetToken")
}

// ================================
// Campaigns
// ================================

model Campaign {
   id String @id @default(cuid()) @map("_id")

   creatorId String
   creator   User   @relation("CampaignCreator", fields: [creatorId], references: [id], onDelete: Cascade)

   // Basics
   title          String
   brandName      String
   brandLogo      String?
   coverImage     String?
   imageUrl       String?
   description    String?
   category       String  @default("content")
   targetAudience String  @default("")

   // Money — all in cents to avoid float issues
   budgetCents                    Int @default(0)
   spentCents                     Int @default(0)
   minimumContributionCents       Int @default(0)
   targetViews                    Int @default(0)
   campaignCostCredits            Int @default(0)

   // Payout per 1,000 views (in cents)
   rateTiktokCents    Int @default(0)
   rateXCents         Int @default(0)
   rateInstagramCents Int @default(0)
   rateYoutubeCents   Int @default(0)
   rateFacebookCents  Int @default(0)

   // Which platforms are enabled
   platforms String[] @default([])

   // Min / max payout per clip
   minPayoutCents Int @default(0)
   maxPayoutCents Int @default(0)

   // Requirements & references
   requirements String?
   referenceUrl String?

   status CampaignStatus @default(DRAFT)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   submissions        Submission[]
   members            CampaignMember[]
   contributors       CampaignContributor[]
   creditTransactions CreditLedger[]
   transactions       Transaction[]

   @@index([status])
   @@index([creatorId])
   @@map("Campaign")
}

model CampaignMember {
   id String @id @default(cuid()) @map("_id")

   campaignId String
   userId     String
   campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
   user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

   joinedAt DateTime @default(now())

   @@unique([campaignId, userId])
   @@index([userId])
   @@map("CampaignMember")
}

model Submission {
   id String @id @default(cuid()) @map("_id")

   campaignId String
   userId     String
   campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
   user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

   url      String
   platform String
   views    Int    @default(0)

   earningsCents Int              @default(0)
   status        SubmissionStatus @default(PENDING)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   @@index([campaignId])
   @@index([userId])
   @@index([status])
   @@map("Submission")
}

// ================================
// Messaging
// ================================

model Conversation {
   id        String   @id @default(cuid()) @map("_id")
   title     String?
   isGroup   Boolean  @default(false)
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   members  ConversationMember[]
   messages Message[]

   @@index([updatedAt])
   @@map("Conversation")
}

model ConversationMember {
   id             String   @id @default(cuid()) @map("_id")
   conversationId String
   userId         String
   joinedAt       DateTime @default(now())
   lastReadAt     DateTime @default(now())

   conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
   user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@unique([conversationId, userId])
   @@index([userId])
   @@map("ConversationMember")
}

model Message {
   id             String   @id @default(cuid()) @map("_id")
   conversationId String
   senderId       String
   recipientId    String?
   body           String
   content        String   @default("")
   messageType    String   @default("private")
   read           Boolean  @default(false)
   createdAt      DateTime @default(now())
   updatedAt      DateTime @default(now()) @updatedAt

   conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
   sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
   recipient    User?        @relation("ReceivedMessages", fields: [recipientId], references: [id])

   @@index([conversationId, createdAt])
   @@index([senderId, createdAt])
   @@index([recipientId, createdAt])
   @@map("Message")
}

// ================================
// Notifications
// ================================

model Notification {
   id        String   @id @default(cuid()) @map("_id")
   userId    String
   title     String
   message   String
   type      String
   read      Boolean  @default(false)
   link      String?
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id])

   @@index([userId, createdAt])
   @@map("Notification")
}

// ================================
// Payments & Credits
// ================================

model Transaction {
   id              String   @id @default(cuid()) @map("_id")
   amountCents     Int
   currency        String   @default("USD")
   status          String
   paymentId       String?
   providerRef     String?
   userId          String
   amountPaidCents Int      @default(0)
   campaignId      String?
   createdAt       DateTime @default(now())
   updatedAt       DateTime @updatedAt

   user     User      @relation(fields: [userId], references: [id])
   campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

   @@index([userId, status])
   @@index([createdAt])
   @@map("Transaction")
}

model CampaignContributor {
   id                String   @id @default(cuid()) @map("_id")
   userId            String
   campaignId        String
   contributionCents Int
   createdAt         DateTime @default(now())

   user     User     @relation(fields: [userId], references: [id])
   campaign Campaign @relation(fields: [campaignId], references: [id])

   @@unique([campaignId, userId])
   @@index([campaignId])
   @@map("CampaignContributor")
}

model CreditPricing {
   id                      String   @id @default("default") @map("_id")
   creditsPerThousandViews Int      @default(0)
   updatedAt               DateTime @updatedAt

   @@map("CreditPricing")
}

model CreditLedger {
   id          String   @id @default(cuid()) @map("_id")
   userId      String
   campaignId  String?
   amount      Int
   description String
   createdAt   DateTime @default(now())

   user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
   campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

   @@index([userId, createdAt])
   @@index([campaignId])
   @@map("CreditLedger")
}